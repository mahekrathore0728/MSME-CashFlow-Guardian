# ==============================================================================
# MSME CashFlow Guardian - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' (in root or backend/) and adjust configuration.
# Never commit actual secret keys or API credentials to version control.

# Application Environment (development | production | test)
ENVIRONMENT=development

# Application Identification
PROJECT_NAME="MSME CashFlow Guardian"
VERSION="1.0.0"

# Cryptographic Secret Key
# In production, must be at least 32 characters and cryptographically random.
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=msme-guardian-dev-secret-key-change-in-prod-2026

# JWT Algorithm and Expiration (Minutes)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated list, no wildcards when using credentials)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Database Connection URL (SQLite default for local, PostgreSQL for enterprise production)
DATABASE_URL="sqlite:///./guardian.db"

# Optional: Google Gemini AI Integration
# Leave empty to utilize the platform's deterministic, rule-based financial analysis engine.
# If provided, the backend synthesizes AI-assisted cash flow narratives.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.0-flash"
