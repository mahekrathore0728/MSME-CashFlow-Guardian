# ==============================================================================
# MSME CashFlow Guardian - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to 'backend/.env' and customize.

ENVIRONMENT=development
PROJECT_NAME="MSME CashFlow Guardian"
VERSION="1.0.0"

# Cryptographic Secret Key
SECRET_KEY=msme-guardian-dev-secret-key-change-in-prod-2026

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Database Connection
DATABASE_URL="sqlite:///./guardian.db"

# Optional: Google Gemini AI Integration
# Leave blank to use offline deterministic financial analysis rules.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.0-flash"
